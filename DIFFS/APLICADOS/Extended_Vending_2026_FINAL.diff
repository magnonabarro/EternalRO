+
+char *GetComma(unsigned long n)
+{
+	static char retbuf[32];
+	static char comma = 0;
+	char *p = &retbuf[sizeof(retbuf) - 1];
+	int32 i = 0;
+
+	if (comma == 0) {
+		const struct lconv *lcp = localeconv();
+		if (lcp != nullptr && lcp->thousands_sep != nullptr && *lcp->thousands_sep != '\0')
+			comma = *lcp->thousands_sep;
+		else
+			comma = ',';
+	}
+
+	*p = '\0';
+	do {
+		if (i != 0 && i % 3 == 0)
+			*--p = comma;
+		*--p = static_cast<char>('0' + (n % 10));
+		n /= 10;
+		i++;
+	} while (n != 0);
+
+	return p;
+}
