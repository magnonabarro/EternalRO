+	nullpo_ret(sd);
+
+	const bool is_zeny = (ITEMID_ZENY != 0 && nameid == ITEMID_ZENY);
+	const bool is_cash = (ITEMID_CASH != 0 && nameid == ITEMID_CASH);
+	const bool is_item = (itemdb_vending.find(nameid) != nullptr);
