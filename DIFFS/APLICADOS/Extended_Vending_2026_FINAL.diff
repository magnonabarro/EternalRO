+	sd->vend_loot = nameid;
+	sd->state.prevend = 1;
+	sd->state.workinprogress = WIP_DISABLE_ALL;
+
+	char output[CHAT_SIZE_MAX];
+	safesnprintf(output, sizeof(output), msg_txt(sd, 1594), itemdb_ename(nameid));
+	clif_openvendingreq(*sd, static_cast<uint16>(2 + sd->vend_skill_lv));
+	clif_messagecolor(sd, color_table[COLOR_CYAN], output, false, SELF);
