@@ -10155,6 +10155,46 @@ ACMD_FUNC(accinfo) {
 	return 0;
 }
 
+/*==========================================
+ * @afk
+ * Initial release by Axl, Rebel
+ * Additional configurations by Secret
+ *------------------------------------------*/
+ACMD_FUNC(afk) {
+	nullpo_retr(-1, sd);
+
+	if( pc_isdead(sd) ) {
+		clif_displaymessage(fd, "You can't use @afk if you are dead.");
+		return -1;
+	}
+
+	if( map_getmapflag(sd->m, MF_AFK) == battle_config.afk_mapflag ) { // Add afk mapflag support [secretdataz]
+		if( map_getmapflag(sd->m, MF_PVP) || map_getmapflag(sd->m, MF_GVG) ) {
+			clif_displaymessage(fd, "You can't use @afk in PVP or GVG map.");
+			return -1;
+		}
+
+		sd->state.autotrade = 1;
+		if( battle_config.afk_battleignore )
+			sd->state.block_action |= PCBLOCK_IMMUNE;
+		pc_setsit(sd);
+		skill_sit(sd, true);
+		clif_sitting(*sd);
+		if( battle_config.afk_viewid )
+			clif_changelook(sd, LOOK_HEAD_TOP, battle_config.afk_viewid);
+		if( battle_config.afk_timeout ) {
+			int32 timeout = atoi(message);
+			status_change_start(nullptr, sd, SC_AUTOTRADE, 10000, 0, 0, 0, 0,
+				((timeout > 0) ? min(timeout, battle_config.afk_timeout) : battle_config.afk_timeout) * 60000,
+				SCSTART_NONE);
+		}
+		clif_authfail_fd(fd, 15);
+	} else
+		clif_displaymessage(fd, "@afk is not allowed on this map.");
+
+	return 0;
+}
+
