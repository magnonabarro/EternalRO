--- /dev/null
+++ b/conf/battle/afk.conf
@@ -0,0 +1,15 @@
+//--------------------------------------------------------------
+// AFK command configuration
+//--------------------------------------------------------------
+
+// Set this to the amount of minutes AFK chars will be kicked from the server.
+afk_timeout: 0
+
+// Allow @afk only in maps with "afk" flag?
+// Set this to "no" to allow @afk where no "afk" mapflag is set.
+// Set this to "yes" to only allow @afk on maps with "afk" mapflag.
+afk_mapflag: no
+
+// Headgear ViewID for AFK hat. Set to 0 to disable.
+afk_viewid: 471
+
+// Should AFK characters be invincible like @battleignore?
+afk_battleignore: no
