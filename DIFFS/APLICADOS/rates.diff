+			default:
+				custom = (is_mvp && sd->custom_rate.item_rate_common_mvp > 0) || (is_boss && sd->custom_rate.item_rate_common_boss > 0) || sd->custom_rate.item_rate_common > 0 || sd->custom_rate.item_drop_common_min > 0 || sd->custom_rate.item_drop_common_max > 0;
+				rate_adjust = is_mvp && sd->custom_rate.item_rate_common_mvp > 0 ? sd->custom_rate.item_rate_common_mvp : is_boss && sd->custom_rate.item_rate_common_boss > 0 ? sd->custom_rate.item_rate_common_boss : sd->custom_rate.item_rate_common > 0 ? sd->custom_rate.item_rate_common : is_mvp ? battle_config.item_rate_common_mvp : is_boss ? battle_config.item_rate_common_boss : battle_config.item_rate_common;
+				rate_min = sd->custom_rate.item_drop_common_min > 0 ? static_cast<uint16>(sd->custom_rate.item_drop_common_min) : battle_config.item_drop_common_min;
+				rate_max = sd->custom_rate.item_drop_common_max > 0 ? static_cast<uint16>(sd->custom_rate.item_drop_common_max) : battle_config.item_drop_common_max;
+				break;
+		}
+	}
+
+	if (!custom)
+		return false;
+
+	item_dropratio_adjust(drop->nameid, static_cast<int32>(mob->id), &rate_adjust);
+	*rate = static_cast<int32>(mob_drop_adjust(static_cast<int32>(drop->rateSet), rate_adjust, rate_min, rate_max));
+	return true;
+}
+
 const std::string JobDatabase::getDefaultLocation() {
 	return std::string(db_path) + "/job_stats.yml";
 }
