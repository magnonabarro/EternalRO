@@ -11623,6 +12028,8 @@ void atcommand_basecommands(void) {
 		ACMD_DEF(partysharelvl),
 		ACMD_DEF(mapinfo),
 		ACMD_DEF(dye),
+		ACMD_DEF(ws),
+		ACMD_DEF(wb),
 		ACMD_DEF(hair_style),
 		ACMD_DEF(hair_color),
 		ACMD_DEF(stat_all),
