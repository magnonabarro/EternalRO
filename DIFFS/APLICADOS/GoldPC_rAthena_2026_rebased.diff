+	if(vip_status(VIP_STATUS_ACTIVE)==1||getgroupid()==99)
+		goto VIP; //Custom. In KRo there's two PC cafe grade : gold and silver.
+	else
+		goto Normal;
+Normal:
+	mes "[프버방시피]";
