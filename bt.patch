 /**
+ * Route the custom Instance Manager entry through the existing Battleground Queue UI.
+ * The client sends a queue request with the display name from entryqueuelist.lub.
+ * For the first integration stage, only "Torre Sem Fim" is handled here.
+ *
+ * @return true if the request was handled by the Instance Manager, otherwise false.
+ */
+static bool bg_queue_try_instance_manager_request(const char *name, map_session_data *sd, bool party_request)
+{
+	if (name == nullptr || sd == nullptr || strcmpi(name, "Torre Sem Fim") != 0)
+		return false;
+
+	const char *event_name = party_request
+		? "InstanceManagerBridge::OnEndlessTowerParty"
+		: "InstanceManagerBridge::OnEndlessTowerSolo";
+
+	if (npc_event_do_id(event_name, sd->id) <= 0) {
+		clif_bg_queue_apply_result(BG_APPLY_INVALID_NAME, name, sd);
+		clif_displaymessage(sd->fd, "Gerenciador de Instancias nao carregado. Verifique npc/scripts_custom.conf.");
+		return true;
+	}
+
+	// This request is an instance launch, not a real Battleground queue.
+	clif_bg_queue_apply_result(BG_APPLY_QUEUE_FINISHED, name, sd);
+	clif_bg_queue_entry_init(sd);
+	return true;
+}
